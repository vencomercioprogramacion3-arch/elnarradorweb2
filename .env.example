# Copia este archivo a `.env.local` y rellena los valores reales.
# NUNCA subas `.env.local` ni claves reales al repositorio.
# Guía completa de la base en Neubox: neubox/README.md

# --- Base de datos MySQL (Neubox / phpMyAdmin) (obligatorias) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- Login del panel /admin (obligatoria) ---
# Clave aleatoria de 32+ caracteres para firmar la cookie de sesión.
# Genera una con: openssl rand -hex 32
AUTH_SECRET=

# --- Subida de imágenes y PDFs al hosting Neubox (obligatorias para el admin) ---
# URL de neubox/media/upload.php ya copiado en el hosting
NEUBOX_UPLOAD_URL=
# La misma UPLOAD_KEY definida en media/config.php del hosting
NEUBOX_UPLOAD_KEY=

# --- Sitio ---
# URL pública del sitio. Se usa para metadata, sitemap y JSON-LD.
NEXT_PUBLIC_SITE_URL=

# --- Migración de WordPress (opcionales si no migras contenido) ---
# Endpoint REST del WordPress de origen, p.ej. https://misitio.com/wp-json/wp/v2
WORDPRESS_API_URL=

# Secreto que protege POST /api/migrate (header x-migration-key)
MIGRATION_SECRET_KEY=
